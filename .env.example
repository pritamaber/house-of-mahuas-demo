# Copy to .env.local and fill in what you need. The demo runs without any of this.

# ── Store details (shown on the site) ────────────────────────────────────────
# WhatsApp number with country code, digits only — e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your_handle
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ── Admin login ──────────────────────────────────────────────────────────────
# Without these the built-in demo login (admin@mahuas.demo / mahua123) works.
# Set all three before sharing the site with anyone.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# any long random string; signs the admin session cookie
ADMIN_SECRET=

# ── Supabase (optional) ──────────────────────────────────────────────────────
# Leave empty to keep using the local demo database (data/db.json).
# 1. Create a project at supabase.com  2. Run supabase/schema.sql in the SQL editor
# 3. Paste your project URL and *service_role* key (Settings → API) here
# 4. Run `npm run db:reset -- --yes` once to load the sample sarees and orders
# Required on Vercel: without a database, orders can't be saved permanently.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=product-images
# Lets Admin → Settings wipe & re-seed a Supabase database (off by default — it deletes real orders)
# ALLOW_DEMO_RESET=true

# ── Search engines ───────────────────────────────────────────────────────────
# Demo sites are hidden from Google. Set to true when you go live.
# NEXT_PUBLIC_ALLOW_INDEXING=true
